// Cloudflare Worker for the TURBO PITCH website: serves public/index.html and runs LAN-play rooms.
// Deploy: Cloudflare dashboard > Workers & Pages > Create > Import a repository (this repo), or `npx wrangler deploy`.
{
  "name": "turbo-pitch",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "Room" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }]
}
